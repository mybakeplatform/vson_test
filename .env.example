# Copy to .env and fill in. Never commit the real .env.

# Postgres connection string. Required.
# Local docker-compose default:
DATABASE_URL="postgresql://mybake:mybake@localhost:5432/mybake"

# Set to "require" when your Postgres needs TLS (most managed providers do).
# Leave unset/empty for a local docker-compose database.
PGSSLMODE=""

# HTTP port for the API + test console.
PORT="3000"

# Password assigned to every seeded demo user (seed data only, never production users).
SEED_PASSWORD="test-password"

# Comma separated origins allowed to call the API from a browser. "*" allows all.
CORS_ORIGINS="*"
